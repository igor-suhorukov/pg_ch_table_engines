-- VC43 (pg_accel's §3.38, F25): ClickHouse's min/max skip indexes of every
-- numeric and temporal column ClickHouse keeps plain -- a NOT NULL one's --
-- made with each part and merge by default, and read where a scan's granules
-- are chosen: by its quals after the key, here; by a running bound, a granule
-- at a time, in pg_accel's chte leg (chte_bound.sh).  A table whose settings
-- turn them off makes none; a Nullable column has none, as ClickHouse makes
-- none; a text column's are not made.  Every answer the same with the
-- indexes read and not.
SET client_min_messages = warning;
SET ch.insert_buffer_rows = 50000;
CREATE TABLE si (k int NOT NULL, t timestamp NOT NULL, v int8 NOT NULL, d date NOT NULL, s text NOT NULL, n int8)
  USING mergetree WITH (order_by = 'k', settings = 'index_granularity = 1024');
-- four parts of 50,000 rows, k's ranges apart; t falls as k rises, v and d rise with it
INSERT INTO si SELECT i, timestamp '2021-01-01' - i * interval '1 second', i * 3, date '2020-01-01' + i / 1000,
    's' || (i % 97), CASE WHEN i % 5 = 0 THEN NULL ELSE i END
  FROM generate_series(1, 200000) i;
CREATE TABLE si_off (k int NOT NULL, t timestamp NOT NULL, v int8 NOT NULL, d date NOT NULL, s text NOT NULL, n int8)
  USING mergetree WITH (order_by = 'k', settings = 'index_granularity = 1024, add_minmax_index_for_numeric_columns = 0, add_minmax_index_for_temporal_columns = 0');
INSERT INTO si_off SELECT * FROM si;
RESET ch.insert_buffer_rows;
SELECT count(*) AS parts, sum(rows) AS rows FROM ch.parts('si');
 parts |  rows  
-------+--------
     4 | 200000
(1 row)

SELECT position('add_minmax_index_for_numeric_columns = 1' IN ch.definition('si')) > 0 AS made,
       position('add_minmax_index_for_numeric_columns = 0' IN ch.definition('si_off')) > 0 AS not_made;
 made | not_made 
------+----------
 t    | t
(1 row)

-- what ChScan read, from EXPLAIN ANALYZE
CREATE FUNCTION granules(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  plan jsonb;
  node jsonb;
BEGIN
  EXECUTE 'EXPLAIN (ANALYZE, FORMAT JSON) ' || q INTO plan;
  node := jsonb_path_query_first(plan, 'strict $.**? (@."Custom Plan Provider" == "ChScan")');
  RETURN format('%s read of %s, parts pruned: %s', node->>'Granules Read', node->>'Granules', node->>'Parts Pruned');
END $$;
-- every query answered with the indexes read and without, the same
CREATE FUNCTION same_skip(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  with_indexes text;
  without text;
BEGIN
  SET LOCAL ch.enable_skip_indexes = on;
  EXECUTE 'SELECT md5(coalesce(string_agg(r::text, '','' ORDER BY r::text), '''')) FROM (' || q || ') r'
    INTO with_indexes;
  SET LOCAL ch.enable_skip_indexes = off;
  EXECUTE 'SELECT md5(coalesce(string_agg(r::text, '','' ORDER BY r::text), '''')) FROM (' || q || ') r'
    INTO without;
  RETURN CASE WHEN with_indexes = without THEN 'same' ELSE 'DIFFERENT' END;
END $$;
SET max_parallel_workers_per_gather = 0;
-- an int8's range: the part its statistics keep, and two of its granules
SELECT granules('SELECT count(*) FROM si WHERE v BETWEEN 3000 AND 6000');
            granules            
--------------------------------
 2 read of 196, parts pruned: 3
(1 row)

SELECT count(*), sum(v) FROM si WHERE v BETWEEN 3000 AND 6000;
 count |   sum   
-------+---------
  1001 | 4504500
(1 row)

-- with the setting off, or of a table that made none, every granule of the part
SET ch.enable_skip_indexes = off;
SELECT granules('SELECT count(*) FROM si WHERE v BETWEEN 3000 AND 6000');
            granules             
---------------------------------
 49 read of 196, parts pruned: 3
(1 row)

RESET ch.enable_skip_indexes;
SELECT granules('SELECT count(*) FROM si_off WHERE v BETWEEN 3000 AND 6000');
            granules             
---------------------------------
 49 read of 196, parts pruned: 3
(1 row)

-- a timestamp's and a date's
SELECT granules('SELECT count(*) FROM si WHERE t < timestamp ''2021-01-01'' - interval ''199990 seconds''');
            granules            
--------------------------------
 1 read of 196, parts pruned: 3
(1 row)

SELECT granules('SELECT count(*) FROM si WHERE d = date ''2020-01-05''');
            granules            
--------------------------------
 2 read of 196, parts pruned: 3
(1 row)

-- a comparison each way, a constant first, an IN list, an OR of two columns
SELECT granules('SELECT count(*) FROM si WHERE 100000 > v');
            granules             
---------------------------------
 33 read of 196, parts pruned: 3
(1 row)

SELECT granules('SELECT count(*) FROM si WHERE v IN (9, 300000)');
            granules            
--------------------------------
 2 read of 196, parts pruned: 2
(1 row)

SELECT granules('SELECT count(*) FROM si WHERE v = 9 OR d = date ''2020-03-01''');
            granules             
---------------------------------
 98 read of 196, parts pruned: 2
(1 row)

-- none true of any granule
SELECT granules('SELECT count(*) FROM si WHERE v < 0');
            granules            
--------------------------------
 0 read of 196, parts pruned: 4
(1 row)

-- a Nullable column's quals, a text column's: no index, every granule its part's
SELECT granules('SELECT count(*) FROM si WHERE n BETWEEN 3000 AND 6000');
            granules             
---------------------------------
 49 read of 196, parts pruned: 3
(1 row)

SELECT granules('SELECT count(*) FROM si WHERE s = ''s5'' AND k < 1000');
            granules            
--------------------------------
 1 read of 196, parts pruned: 3
(1 row)

SELECT same_skip('SELECT count(*), sum(v) FROM si WHERE v BETWEEN 3000 AND 6000');
 same_skip 
-----------
 same
(1 row)

SELECT same_skip('SELECT k, t FROM si WHERE t >= timestamp ''2020-12-31 23:00:00'' AND v % 2 = 0');
 same_skip 
-----------
 same
(1 row)

SELECT same_skip('SELECT k FROM si WHERE d IN (date ''2020-01-03'', date ''2020-03-01'') OR v = 9');
 same_skip 
-----------
 same
(1 row)

SELECT same_skip('SELECT count(*) FROM si WHERE v <> 6');
 same_skip 
-----------
 same
(1 row)

SELECT same_skip('SELECT count(*) FROM si WHERE v > 599990 OR t > timestamp ''2020-12-31 23:59:50''');
 same_skip 
-----------
 same
(1 row)

SELECT same_skip('SELECT k, n FROM si WHERE n BETWEEN 3000 AND 3010');
 same_skip 
-----------
 same
(1 row)

-- the merged part's indexes, made by the merge
SELECT ch.optimize('si', true) > 0 AS merged;
 merged 
--------
 t
(1 row)

SELECT count(*) AS parts FROM ch.parts('si');
 parts 
-------
     1
(1 row)

SELECT granules('SELECT count(*) FROM si WHERE v BETWEEN 3000 AND 6000');
            granules            
--------------------------------
 2 read of 196, parts pruned: 0
(1 row)

SELECT same_skip('SELECT count(*), sum(v) FROM si WHERE v BETWEEN 3000 AND 6000');
 same_skip 
-----------
 same
(1 row)

DROP FUNCTION granules(text);
DROP FUNCTION same_skip(text);
DROP TABLE si, si_off;
