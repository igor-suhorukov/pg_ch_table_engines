SELECT ch.write_iceberg('/tmp/chte_iceberg/t', 'append', 'SELECT * FROM src WHERE id > 20000 ORDER BY id', NULL,
						'iceberg_insert_max_rows_in_data_file = 8192, output_format_parquet_row_group_size = 1024') > 0 AS appended;
 appended 
