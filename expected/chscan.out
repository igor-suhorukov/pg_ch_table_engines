EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) SELECT count(*) FROM cs WHERE f > 99000000;
                          QUERY PLAN                           
---------------------------------------------------------------
 Aggregate (actual rows=1.00 loops=1)
   ->  Custom Scan (ChScan) on cs (actual rows=900.00 loops=1)
         Filter: (f > 99000000)
         Rows Removed by Filter: 19100
         Columns: f
         Pruning: (f > 99000000)
         Granules: 20 read of 100, parts pruned: 4
(7 rows)

SELECT same_answer('SELECT a, f FROM cs WHERE f > 99000000');
 same_answer 
-------------
 same
(1 row)

SELECT same_answer('SELECT count(*) FROM cs WHERE f IS NULL');
 same_answer 
-------------
