-- Tables of Arrow IPC files (ch_table_engines.md §2.17, CH7's Arrow step): files written by ClickHouse's
-- own Arrow writer -- uncompressed, with LZ4 frames, with zstd -- read through the arrow access method as
-- their Parquet copy and heap read the same rows: the plain scan, ChScan, in parallel, and vexec where it
-- is preloaded.  A table's units are its files' record batches.
\! rm -rf /tmp/chte_arrow && mkdir -p /tmp/chte_arrow/glob
SET extra_float_digits = 0;
CREATE TABLE src (id int8 NOT NULL, i2 int2, i4 int4, f8 float8, n numeric(18, 4), b bool, d date,
				  ts timestamp, tz timestamptz, t text, by bytea, u uuid);
INSERT INTO src
SELECT g, (g % 200 - 100)::int2, CASE WHEN g % 9 = 0 THEN NULL ELSE g * 7 END, g / 3.0,
	   round(g / 7.0, 4), g % 2 = 0, DATE '1998-03-01' + g % 2000,
	   TIMESTAMP '1960-01-01 00:00:00' + g * INTERVAL '17 minutes 0.25 seconds',
	   TIMESTAMPTZ '2010-06-07 08:09:10+02' + g * INTERVAL '3 hours',
	   CASE WHEN g % 13 = 0 THEN NULL ELSE 'arrow ' || g || repeat('ü', g % 4) END,
	   decode(lpad(to_hex(g * 31), 10, '0'), 'hex'),
	   ('11111111-2222-4333-8444-' || lpad(to_hex(g), 12, '0'))::uuid
FROM generate_series(1, 50000) g;
\set columns 'id Int64, i2 Nullable(Int16), i4 Nullable(Int32), f8 Nullable(Float64), n Nullable(Decimal(18, 4)), b Nullable(Bool), d Nullable(Date32), ts Nullable(DateTime64(6, ''UTC'')), tz Nullable(DateTime64(6, ''UTC'')), t Nullable(String), by Nullable(String), u Nullable(FixedString(16))'
SELECT ch.write_file('Parquet', '/tmp/chte_arrow/copy.parquet', 'SELECT * FROM src ORDER BY id', :'columns') > 0 AS parquet;
 parquet 
---------
 t
(1 row)

SELECT codec, ch.write_file('Arrow', '/tmp/chte_arrow/' || codec || '.arrow', 'SELECT * FROM src ORDER BY id', :'columns',
							'output_format_arrow_compression_method = ''' || codec || '''') > 0 AS arrow
FROM (VALUES ('none'), ('lz4_frame'), ('zstd')) c (codec);
   codec   | arrow 
-----------+-------
 none      | t
 lz4_frame | t
 zstd      | t
(3 rows)

SELECT a.size > b.size AS lz4_smaller, a.size > c.size AS zstd_smaller
FROM pg_stat_file('/tmp/chte_arrow/none.arrow') a, pg_stat_file('/tmp/chte_arrow/lz4_frame.arrow') b,
	 pg_stat_file('/tmp/chte_arrow/zstd.arrow') c;
 lz4_smaller | zstd_smaller 
-------------+--------------
 t           | t
(1 row)

CREATE TABLE pq (LIKE src) USING parquet WITH (location = '/tmp/chte_arrow/copy.parquet');
CREATE TABLE a_none (LIKE src) USING arrow WITH (location = '/tmp/chte_arrow/none.arrow');
CREATE TABLE a_lz4 (LIKE src) USING arrow WITH (location = '/tmp/chte_arrow/lz4_frame.arrow');
CREATE TABLE a_zstd (LIKE src) USING arrow WITH (location = '/tmp/chte_arrow/zstd.arrow');
SELECT t, f.rows, f.units > 1 AS batches, f.first_row FROM unnest(ARRAY['a_none', 'a_lz4', 'a_zstd']) t,
	LATERAL ch.external_files(t::regclass) f;
   t    | rows  | batches | first_row 
--------+-------+---------+-----------
 a_none | 50000 | t       |         0
 a_lz4  | 50000 | t       |         0
 a_zstd | 50000 | t       |         0
(3 rows)

-- every row heap's and the Parquet copy's, both ways
CREATE FUNCTION rows_differ(a text, b text, cols text DEFAULT 'id, i2, i4, f8, n, b, d, ts, tz, t, by, u')
RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE
	n bigint;
BEGIN
	EXECUTE format('SELECT count(*) FROM ((SELECT %3$s FROM %1$s EXCEPT ALL SELECT %3$s FROM %2$s)
					UNION ALL (SELECT %3$s FROM %2$s EXCEPT ALL SELECT %3$s FROM %1$s)) diff', a, b, cols) INTO n;
	RETURN n;
END $$;
SET ch.enable_chscan = off;
SELECT t, rows_differ(t, 'src') AS heap, rows_differ(t, 'pq') AS parquet
FROM unnest(ARRAY['a_none', 'a_lz4', 'a_zstd']) t;
   t    | heap | parquet 
--------+------+---------
 a_none |    0 |       0
 a_lz4  |    0 |       0
 a_zstd |    0 |       0
(3 rows)

RESET ch.enable_chscan;
SELECT t, rows_differ(t, 'src') AS heap, rows_differ(t, 'pq') AS parquet, rows_differ(t, 'pq', 'id, d, t') AS some
FROM unnest(ARRAY['a_none', 'a_lz4', 'a_zstd']) t;
   t    | heap | parquet | some 
--------+------+---------+------
 a_none |    0 |       0 |    0
 a_lz4  |    0 |       0 |    0
 a_zstd |    0 |       0 |    0
(3 rows)

EXPLAIN (COSTS OFF) SELECT id, d FROM a_zstd WHERE d > '2000-01-01';
             QUERY PLAN             
------------------------------------
 Custom Scan (ChScan) on a_zstd
   Filter: (d > '01-01-2000'::date)
   Columns: id, d
(3 rows)

-- aggregates, a join, each as the Parquet copy's
SELECT 'pq' AS t, count(*), count(i4), sum(i2), sum(i4), sum(f8), sum(n), min(d), max(d), min(ts), max(tz), sum(length(t)), max(by)
FROM pq
UNION ALL
SELECT 'a_none', count(*), count(i4), sum(i2), sum(i4), sum(f8), sum(n), min(d), max(d), min(ts), max(tz), sum(length(t)), max(by)
FROM a_none
UNION ALL
SELECT 'a_lz4', count(*), count(i4), sum(i2), sum(i4), sum(f8), sum(n), min(d), max(d), min(ts), max(tz), sum(length(t)), max(by)
FROM a_lz4
UNION ALL
SELECT 'a_zstd', count(*), count(i4), sum(i2), sum(i4), sum(f8), sum(n), min(d), max(d), min(ts), max(tz), sum(length(t)), max(by)
FROM a_zstd
ORDER BY 1;
