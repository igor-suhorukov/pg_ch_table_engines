EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT count(*) FROM a_zstd WHERE id % 1000 = 0;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1.00 loops=1)
   ->  Gather (actual rows=3.00 loops=1)
         Workers Planned: 2
         Workers Launched: 2
         ->  Partial Aggregate (actual rows=1.00 loops=3)
               ->  Parallel Custom Scan (ChScan) on a_zstd (actual rows=16.67 loops=3)
                     Filter: ((id % '1000'::bigint) = 0)
                     Rows Removed by Filter: 16650
                     Columns: id
                     Record Batches: 7 read of 7
(10 rows)

RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
RESET max_parallel_workers_per_gather;
-- with vexec, where it is preloaded: its scans through the source, in both its batch formats
CREATE FUNCTION vexec_scans(query text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE
	line text;
	found boolean := false;
BEGIN
	IF current_setting('shared_preload_libraries') NOT LIKE '%vexec%' THEN
		RETURN;
	END IF;
	FOR line IN EXECUTE 'EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || query LOOP
		found := found OR line LIKE '%Source: arrow%';
	END LOOP;
	IF NOT found THEN
		RAISE EXCEPTION 'vexec does not scan: %', query;
	END IF;
END $$;
SET vexec.mode = force;
SET vexec.batch_dictionary = off;
SET vexec.batch_format = postgres;
SELECT vexec_scans('SELECT id, i4, d, t FROM a_lz4 WHERE d > ''2001-06-01''');
 vexec_scans 
-------------
 
(1 row)

