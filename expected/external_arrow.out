 a_none | 50000 | 44445 | -25000 | 7777972230 | 416675000 | 178575000.0000 | 03-01-1998 | 08-21-2003 | Fri Jan 01 00:17:00.25 1960 | Sat Jul 17 23:09:10 2027 PDT | 566671 | \x000017a6b0
 a_zstd | 50000 | 44445 | -25000 | 7777972230 | 416675000 | 178575000.0000 | 03-01-1998 | 08-21-2003 | Fri Jan 01 00:17:00.25 1960 | Sat Jul 17 23:09:10 2027 PDT | 566671 | \x000017a6b0
 pq     | 50000 | 44445 | -25000 | 7777972230 | 416675000 | 178575000.0000 | 03-01-1998 | 08-21-2003 | Fri Jan 01 00:17:00.25 1960 | Sat Jul 17 23:09:10 2027 PDT | 566671 | \x000017a6b0
(4 rows)

SELECT count(*), sum(z.i4 - p.i4) FROM a_zstd z JOIN pq p USING (id) WHERE z.u = p.u AND z.ts = p.ts;
