-- the checks of the Parquet step's: a column the files lack, a type that cannot take theirs, a NULL refused
CREATE TABLE bad (nope bigint) USING arrow WITH (location = '/tmp/chte_arrow/none.arrow');
ERROR:  checking the files of "bad": column "nope" of "bad" is not in file /tmp/chte_arrow/none.arrow
DETAIL:  ClickHouse error code 8.
CREATE TABLE bad (id integer) USING arrow WITH (location = '/tmp/chte_arrow/none.arrow');
ERROR:  checking the files of "bad": column "id" of "bad" cannot take the values of file /tmp/chte_arrow/none.arrow, of ClickHouse's type Int64
DETAIL:  ClickHouse error code 53.
CREATE TABLE bad (id bigint) USING arrow WITH (location = '/tmp/chte_arrow/copy.parquet');
ERROR:  checking the files of "bad": Not an Arrow file: missing leading magic
DETAIL:  ClickHouse error code 117.
CREATE TABLE nn (i4 integer NOT NULL) USING arrow WITH (location = '/tmp/chte_arrow/zstd.arrow');
SELECT sum(i4) FROM nn;
ERROR:  reading a file: file /tmp/chte_arrow/zstd.arrow holds a NULL of column "i4", which the table declares NOT NULL
DETAIL:  ClickHouse error code 349.
DROP TABLE nn;
