-- read only: writes, locks and indexes refused
INSERT INTO ext (id) VALUES (1);
ERROR:  cannot insert into "ext"
DETAIL:  A table of access method parquet reads the files at its location, and is never written.
UPDATE ext SET i2 = 0 WHERE id = 1;
ERROR:  cannot update "ext"
DETAIL:  A table of access method parquet reads the files at its location, and is never written.
DELETE FROM ext WHERE id = 1;
ERROR:  cannot delete from "ext"
DETAIL:  A table of access method parquet reads the files at its location, and is never written.
SELECT id FROM ext WHERE id = 1 FOR UPDATE;
ERROR:  cannot lock rows of "ext"
DETAIL:  A table of access method parquet reads the files at its location, and is never written.
CREATE INDEX ON ext (id);
ERROR:  indexes are not supported on "ext"
DETAIL:  Its rows are its files'; their statistics prune what a scan reads.
SELECT count(*) FROM ext TABLESAMPLE SYSTEM (10);
ERROR:  TABLESAMPLE is not supported on "ext"
CREATE TABLE parted (id bigint) PARTITION BY RANGE (id);
CREATE TABLE p1 PARTITION OF parted FOR VALUES FROM (0) TO (10) USING parquet WITH (location = '/tmp/chte_external/all.parquet');
ERROR:  a table of access method parquet cannot be partitioned or a partition
ALTER TABLE parted ATTACH PARTITION g FOR VALUES FROM (0) TO (10);
ERROR:  a table of access method parquet cannot be a partition
DROP TABLE parted;
ALTER TABLE src SET ACCESS METHOD parquet;
ERROR:  cannot change the access method of a table to parquet
HINT:  Make the table with CREATE TABLE ... USING parquet WITH (location = '...').
-- COPY of the table returns no rows (the user's rule, for pg_dump); its query form reads them
COPY ext TO STDOUT;
NOTICE:  COPY of ext returns no rows: its rows are those of the files at its location
HINT:  COPY (SELECT * FROM ext) TO ... reads them.
COPY ext (id, t) TO STDOUT WITH (FORMAT csv, HEADER);
NOTICE:  COPY of ext returns no rows: its rows are those of the files at its location
HINT:  COPY (SELECT * FROM ext) TO ... reads them.
id,t
COPY (SELECT id, t FROM ext WHERE id < 4 ORDER BY id) TO STDOUT;
